      <div className="max-w-7xl mx-auto px-6">
        <div className="flex items-center justify-between h-16">

          {/* Logo */}
          <Link to="/" className="text-2xl font-bold text-red-600 tracking-wide">
            Dr.AI
          </Link>

          {/* Center Navigation */}
          <nav className="hidden md:flex space-x-10 text-gray-700 font-medium">
            <Link to="/" className="hover:text-red-600 transition">Home</Link>
            <Link to="/chat" className="hover:text-red-600 transition">Chat</Link>
            <Link to="/symptoms" className="hover:text-red-600 transition">Symptoms</Link>
            <Link to="/meds" className="hover:text-red-600 transition">Medicines</Link>
